# Copiar como .env (no se sube al repo) y completar.
DEEPSEEK_API_KEY=sk-...

# Codigo que pide la app antes de leer. Sin el, cualquiera con el link gasta
# tu saldo. Vacio = desactivado (solo para pruebas locales).
ACCESS_CODE=

# Origenes que pueden llamar al backend directo, separados por coma. Con el
# rewrite de Next no hace falta: el navegador habla solo con el frontend.
CORS_ORIGINS=http://localhost:3000
