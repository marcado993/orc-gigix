# Copiar como .env y completar. El .env no se sube al repo.

# Claves de API. Alcanza con una. Tambien se pueden cargar despues desde
# Ajustes, en la app, para probar sin tocar este archivo.
#   DeepSeek: https://platform.deepseek.com
#   OpenAI:   https://platform.openai.com
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Codigo que la app pide antes de leer. Si la app va a estar en internet,
# ponelo si o si: sin el, cualquiera con el link gasta tu saldo.
ACCESS_CODE=

# Puerto de esta maquina donde queda la app.
PUERTO=3000
